import struct, sys
pcm = open(sys.argv[1], 'rb').read()
with open(sys.argv[2], 'wb') as f:
    f.write(b'RIFF')
    f.write(struct.pack('<I', len(pcm) + 36))
    f.write(b'WAVEfmt ')
    f.write(struct.pack('<IHHIIHH', 16, 1, 1, 24000, 48000, 2, 16))
    f.write(b'data')
    f.write(struct.pack('<I', len(pcm)))
